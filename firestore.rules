rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Filet de sécurité global : refus par défaut
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isVerified() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasValidParentUser(userId) {
      return exists(/databases/$(database)/documents/users/$(userId));
    }

    function isValidDateString(val) {
      return val is string && val.size() == 10 && val.matches('^\\d{4}-\\d{2}-\\d{2}$');
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll([
          'uid', 'displayName', 'email', 'splitNeeds', 'splitWants', 'splitSavings',
          'theme', 'browserNotificationsEnabled', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'displayName', 'email', 'splitNeeds', 'splitWants', 'splitSavings',
          'theme', 'browserNotificationsEnabled', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
        data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 100 &&
        data.email is string && data.email.size() >= 3 && data.email.size() <= 160 &&
        data.splitNeeds is int && data.splitNeeds >= 0 && data.splitNeeds <= 100 &&
        data.splitWants is int && data.splitWants >= 0 && data.splitWants <= 100 &&
        data.splitSavings is int && data.splitSavings >= 0 && data.splitSavings <= 100 &&
        (data.splitNeeds + data.splitWants + data.splitSavings) == 100 &&
        data.theme is string && (data.theme == 'light' || data.theme == 'dark') &&
        data.browserNotificationsEnabled is bool &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidTransaction(data, userId) {
      return data.keys().hasAll([
          'uid', 'date', 'label', 'amount', 'kind', 'bucket', 'category', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'date', 'label', 'amount', 'kind', 'bucket', 'category', 'note', 'goalId', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
        isValidDateString(data.date) &&
        data.label is string && data.label.size() >= 1 && data.label.size() <= 120 &&
        (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 100000000000 &&
        data.kind is string && (data.kind == 'income' || data.kind == 'expense') &&
        data.bucket is string && (
          (data.kind == 'income' && data.bucket == 'none') ||
          (data.kind == 'expense' && (data.bucket == 'needs' || data.bucket == 'wants' || data.bucket == 'savings'))
        ) &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        (!('note' in data) || (data.note is string && data.note.size() <= 240)) &&
        (!('goalId' in data) || (data.goalId is string && isValidId(data.goalId))) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidGoal(data, userId) {
      return data.keys().hasAll([
          'uid', 'title', 'targetAmount', 'currentAmount', 'regularAmount',
          'regularFrequency', 'deadline', 'priority', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'title', 'targetAmount', 'currentAmount', 'regularAmount',
          'regularFrequency', 'deadline', 'priority', 'description', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        (data.targetAmount is int || data.targetAmount is float) && data.targetAmount > 0 && data.targetAmount <= 100000000000 &&
        (data.currentAmount is int || data.currentAmount is float) && data.currentAmount >= 0 && data.currentAmount <= 100000000000 &&
        (data.regularAmount is int || data.regularAmount is float) && data.regularAmount >= 0 && data.regularAmount <= 100000000000 &&
        data.regularFrequency is string && (data.regularFrequency == 'weekly' || data.regularFrequency == 'monthly') &&
        isValidDateString(data.deadline) &&
        data.priority is string && (data.priority == 'high' || data.priority == 'medium' || data.priority == 'low') &&
        (!('description' in data) || (data.description is string && data.description.size() <= 240)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidReminder(data, userId) {
      return data.keys().hasAll([
          'uid', 'title', 'amount', 'dueDate', 'frequency', 'bucket',
          'category', 'notifyDaysBefore', 'enabled', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'title', 'amount', 'dueDate', 'frequency', 'bucket',
          'category', 'notifyDaysBefore', 'enabled', 'lastPaidDate', 'note', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
        data.title is string && data.title.size() >= 1 && data.title.size() <= 100 &&
        (data.amount is int || data.amount is float) && data.amount > 0 && data.amount <= 100000000000 &&
        isValidDateString(data.dueDate) &&
        data.frequency is string && (
          data.frequency == 'once' ||
          data.frequency == 'weekly' ||
          data.frequency == 'monthly' ||
          data.frequency == 'quarterly' ||
          data.frequency == 'yearly'
        ) &&
        data.bucket is string && (data.bucket == 'needs' || data.bucket == 'wants' || data.bucket == 'savings') &&
        data.category is string && data.category.size() >= 1 && data.category.size() <= 60 &&
        data.notifyDaysBefore is int && data.notifyDaysBefore >= 0 && data.notifyDaysBefore <= 60 &&
        data.enabled is bool &&
        (!('lastPaidDate' in data) || (data.lastPaidDate is string && data.lastPaidDate.size() <= 10)) &&
        (!('note' in data) || (data.note is string && data.note.size() <= 240)) &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    function isValidCategory(data, userId) {
      return data.keys().hasAll([
          'uid', 'name', 'kind', 'bucket', 'color', 'createdAt', 'updatedAt'
        ]) &&
        data.keys().hasOnly([
          'uid', 'name', 'kind', 'bucket', 'color', 'createdAt', 'updatedAt'
        ]) &&
        data.uid is string && data.uid == userId && data.uid == request.auth.uid &&
        data.name is string && data.name.size() >= 1 && data.name.size() <= 50 &&
        data.kind is string && (data.kind == 'income' || data.kind == 'expense') &&
        data.bucket is string && (
          (data.kind == 'income' && data.bucket == 'none') ||
          (data.kind == 'expense' && (data.bucket == 'needs' || data.bucket == 'wants' || data.bucket == 'savings'))
        ) &&
        data.color is string && data.color.size() == 7 && data.color.matches('^#[0-9A-Fa-f]{6}$') &&
        data.createdAt is timestamp &&
        data.updatedAt is timestamp;
    }

    match /users/{userId} {
      allow get: if isValidId(userId) && isOwner(userId);
      allow list: if false;

      allow create: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().createdAt == request.time &&
        incoming().updatedAt == request.time;

      allow update: if isValidId(userId) &&
        isOwner(userId) &&
        isValidUserProfile(incoming(), userId) &&
        incoming().uid == existing().uid &&
        incoming().createdAt == existing().createdAt &&
        incoming().updatedAt == request.time &&
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['splitNeeds', 'splitWants', 'splitSavings', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['theme', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['browserNotificationsEnabled', 'updatedAt']) ||
          incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'updatedAt'])
        );

      allow delete: if isValidId(userId) && isOwner(userId);

      match /transactions/{transactionId} {
        allow get: if isValidId(userId) && isValidId(transactionId) && isOwner(userId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(transactionId) &&
          isOwner(userId) &&
          hasValidParentUser(userId) &&
          isValidTransaction(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isValidId(userId) && isValidId(transactionId) &&
          isOwner(userId) &&
          hasValidParentUser(userId) &&
          isValidTransaction(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly([
            'date', 'label', 'amount', 'kind', 'bucket', 'category', 'note', 'goalId', 'updatedAt'
          ]);

        allow delete: if isValidId(userId) && isValidId(transactionId) && isOwner(userId) && hasValidParentUser(userId);
      }

      match /goals/{goalId} {
        allow get: if isValidId(userId) && isValidId(goalId) && isOwner(userId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(goalId) &&
          isOwner(userId) &&
          hasValidParentUser(userId) &&
          isValidGoal(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isValidId(userId) && isValidId(goalId) &&
          isOwner(userId) &&
          hasValidParentUser(userId) &&
          isValidGoal(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['currentAmount', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'targetAmount', 'currentAmount', 'regularAmount',
              'regularFrequency', 'deadline', 'priority', 'description', 'updatedAt'
            ])
          );

        allow delete: if isValidId(userId) && isValidId(goalId) && isOwner(userId) && hasValidParentUser(userId);
      }

      match /reminders/{reminderId} {
        allow get: if isValidId(userId) && isValidId(reminderId) && isOwner(userId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(reminderId) &&
          isOwner(userId) &&
          hasValidParentUser(userId) &&
          isValidReminder(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isValidId(userId) && isValidId(reminderId) &&
          isOwner(userId) &&
          hasValidParentUser(userId) &&
          isValidReminder(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          (
            incoming().diff(existing()).affectedKeys().hasOnly(['enabled', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly(['dueDate', 'lastPaidDate', 'enabled', 'updatedAt']) ||
            incoming().diff(existing()).affectedKeys().hasOnly([
              'title', 'amount', 'dueDate', 'frequency', 'bucket', 'category',
              'notifyDaysBefore', 'enabled', 'lastPaidDate', 'note', 'updatedAt'
            ])
          );

        allow delete: if isValidId(userId) && isValidId(reminderId) && isOwner(userId) && hasValidParentUser(userId);
      }

      match /categories/{categoryId} {
        allow get: if isValidId(userId) && isValidId(categoryId) && isOwner(userId) && hasValidParentUser(userId);
        allow list: if isOwner(userId) && resource.data.uid == request.auth.uid;

        allow create: if isValidId(userId) && isValidId(categoryId) &&
          isOwner(userId) &&
          hasValidParentUser(userId) &&
          isValidCategory(incoming(), userId) &&
          incoming().createdAt == request.time &&
          incoming().updatedAt == request.time;

        allow update: if isValidId(userId) && isValidId(categoryId) &&
          isOwner(userId) &&
          hasValidParentUser(userId) &&
          isValidCategory(incoming(), userId) &&
          incoming().uid == existing().uid &&
          incoming().createdAt == existing().createdAt &&
          incoming().updatedAt == request.time &&
          incoming().diff(existing()).affectedKeys().hasOnly(['name', 'kind', 'bucket', 'color', 'updatedAt']);

        allow delete: if isValidId(userId) && isValidId(categoryId) && isOwner(userId) && hasValidParentUser(userId);
      }
    }
  }
}
